diff --git a/composeApp/src/androidMain/kotlin/com/inspiredandroid/kai/diagnostics/AndroidAppLog.kt b/composeApp/src/androidMain/kotlin/com/inspiredandroid/kai/diagnostics/AndroidAppLog.kt
new file mode 100644
